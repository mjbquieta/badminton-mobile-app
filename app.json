{
  "expo": {
    "name": "patatas",
    "slug": "patatas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/walking-potato.jpg",
    "scheme": "patatas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.patatas",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5EBD8",
        "foregroundImage": "./assets/images/walking-potato.jpg",
        "backgroundImage": "./assets/images/walking-potato.jpg",
        "monochromeImage": "./assets/images/walking-potato.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.patatas"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/walking-potato.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/walking-potato.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5EBD8",
          "dark": {
            "backgroundColor": "#2B1B12"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "638601ce-c26b-4ff1-873d-27fb591f1b50"
      }
    }
  }
}
